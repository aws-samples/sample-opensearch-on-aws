# Copy to .env and edit. .env is loaded automatically; CLI flags override env vars.

# --- Indices and output ---
OS_SOURCE_INDEX=products
OS_TARGET_INDEX=products_backup
OS_OUTPUT_FILE=missing_ids.txt

# --- Connection ---
# Auth mode: aws-iam | basic | none
OS_AUTH_MODE=aws-iam

# Domain endpoint (without scheme, no trailing slash)
# AOS managed domain example: search-mydomain-abc123.us-east-1.es.amazonaws.com
OS_HOST=search-mydomain-abc123.us-east-1.es.amazonaws.com
OS_PORT=443

# Optional: override TLS behavior
# OS_USE_SSL=true
# OS_VERIFY_CERTS=true

# --- aws-iam mode ---
# Region for SigV4 signing. Falls back to AWS_REGION or boto3 default.
OS_AWS_REGION=us-east-1
# Credentials are picked up from the boto3 default chain
# (env vars, ~/.aws/credentials, instance profile, SSO, etc.) — do NOT put them here.

# --- basic auth mode ---
# OS_USER=admin
# OS_PASSWORD=changeme

# --- Scroll tuning ---
# OS_SCROLL_SIZE=1000
# OS_SCROLL_TIME=5m
