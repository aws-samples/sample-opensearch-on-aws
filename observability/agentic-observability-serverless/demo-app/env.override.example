# Append to the OTel Demo's .env.override (values the stock agent reads, plus one added by patches/agent/llm.py)
DEMO_VERSION=3.1.0                  # pin the images; the demo's .env defaults to "latest"
USE_VCR=False                       # live model calls instead of recorded replies
LLM_BASE_URL=http://litellm:4000    # the LiteLLM proxy from compose.bedrock.yaml
LLM_MODEL=claude-haiku-5-5          # default / fallback alias
LLM_TLS_VERIFY=True
API_KEY=<same value as LITELLM_MASTER_KEY in litellm/litellm.env>
# weighted model mix, chosen per conversation inside the agent (alias:weight, comma separated)
LLM_MODEL_WEIGHTS=claude-haiku-5-5:70,claude-sonnet-5-5:30
LOCUST_USERS=2
