# OpenTelemetry Demo overrides for this sample
# pin the service images to the same release as the checkout (the upstream .env says latest)
DEMO_VERSION=3.1.0
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=3.1.0,deployment.environment.name={{PIPELINE_NAME}}
LOCUST_USERS=2
# live models through LiteLLM -> Amazon Bedrock (instance role), instead of recorded answers
USE_VCR=False
LLM_BASE_URL=http://litellm:4000
LLM_MODEL=claude-haiku-5-5
LLM_TLS_VERIFY=True
API_KEY={{LLM_API_KEY}}
LLM_MODEL_WEIGHTS=claude-haiku-5-5:70,claude-sonnet-5-5:30
