# Copy to config.env and fill in. scripts/render.py substitutes {{KEY}} in every file into rendered/.
# Comments go on their own lines.
REGION=us-east-1
ACCOUNT_ID=111122223333
# Prefix of the Bedrock cross-Region inference profiles in your Region: us, eu, apac, au, jp or global.
# List them with: aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId" --output text
MODEL_PREFIX=us
# Every resource is tagged project=PROJECT_TAG, and scripts/cleanup.sh deletes only tagged resources.
# Use a tag and names that no other deployment in the account uses (the check before step 1 lists clashes).
PROJECT_TAG=otel-agent-observability
DOMAIN_NAME=otel-optimized
# Leave blank; filled after step 1.
DOMAIN_ENDPOINT=
PIPELINE_NAME=otel-demo
# Leave blank; filled after step 3.
INGEST_ENDPOINT=
PIPELINE_ROLE=otel-demo-pipeline-role
HOST_ROLE=otel-demo-host-role
DLQ_BUCKET=otel-demo-dlq-111122223333
CONFIG_BUCKET=otel-demo-config-111122223333
# The IAM user or role ARN that runs these commands, with its IAM path if it has one. IAM Identity Center roles do:
# arn:aws:iam::111122223333:role/aws-reserved/sso.amazonaws.com/<region>/AWSReservedSSO_<permission-set>_<id>
# (aws iam get-role --role-name <name> --query Role.Arn prints it).
ADMIN_ARN=arn:aws:iam::111122223333:role/Admin
LLM_API_KEY=sk-replace-with-any-random-string
# Only for pipeline/pipeline-storage-comparison.yaml; leave blank unless you deploy the storage comparison.
GP_DOMAIN_ENDPOINT=
