{
  "index_patterns": [
    "logs-otel-v1-*"
  ],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "refresh_interval": "30s",
      "index.sort.field": [
        "serviceName",
        "time"
      ],
      "index.sort.order": [
        "asc",
        "desc"
      ],
      "index.parquet.bloom_filter_enabled.field": [
        "traceId"
      ],
      "index.parquet.bloom_filter_enabled.value": [
        true
      ]
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "dynamic_templates": [
        {
          "attributes_string": {
            "path_match": "attributes.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "attributes_long": {
            "path_match": "attributes.*",
            "match_mapping_type": "long",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "attributes_double": {
            "path_match": "attributes.*",
            "match_mapping_type": "double",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "attributes_boolean": {
            "path_match": "attributes.*",
            "match_mapping_type": "boolean",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "resource_attributes_string": {
            "path_match": "resource.attributes.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "resource_attributes_long": {
            "path_match": "resource.attributes.*",
            "match_mapping_type": "long",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "resource_attributes_double": {
            "path_match": "resource.attributes.*",
            "match_mapping_type": "double",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "resource_attributes_boolean": {
            "path_match": "resource.attributes.*",
            "match_mapping_type": "boolean",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "instrumentationScope_attributes_string": {
            "path_match": "instrumentationScope.attributes.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "instrumentationScope_attributes_long": {
            "path_match": "instrumentationScope.attributes.*",
            "match_mapping_type": "long",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "instrumentationScope_attributes_double": {
            "path_match": "instrumentationScope.attributes.*",
            "match_mapping_type": "double",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        },
        {
          "instrumentationScope_attributes_boolean": {
            "path_match": "instrumentationScope.attributes.*",
            "match_mapping_type": "boolean",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false
            }
          }
        }
      ],
      "properties": {
        "time": {
          "type": "date_nanos"
        },
        "@timestamp": {
          "type": "date_nanos"
        },
        "observedTime": {
          "type": "date_nanos"
        },
        "observedTimestamp": {
          "type": "date_nanos"
        },
        "body": {
          "type": "text"
        },
        "eventName": {
          "type": "keyword",
          "ignore_above": 1024,
          "index": false
        },
        "severityText": {
          "type": "keyword",
          "ignore_above": 1024,
          "index": false,
          "low_cardinality": true
        },
        "severityNumber": {
          "type": "integer"
        },
        "severity": {
          "properties": {
            "text": {
              "type": "keyword",
              "ignore_above": 1024,
              "index": false,
              "low_cardinality": true
            },
            "number": {
              "type": "integer"
            }
          }
        },
        "traceId": {
          "type": "keyword",
          "ignore_above": 32,
          "index": false
        },
        "spanId": {
          "type": "keyword",
          "ignore_above": 16,
          "index": false
        },
        "flags": {
          "type": "integer"
        },
        "schemaUrl": {
          "type": "keyword",
          "ignore_above": 512,
          "index": false
        },
        "serviceName": {
          "type": "keyword",
          "ignore_above": 1024,
          "index": false,
          "low_cardinality": true
        },
        "droppedAttributesCount": {
          "type": "integer"
        },
